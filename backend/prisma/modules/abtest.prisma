model feedback {
  id          Int       @id @default(autoincrement())
  user_id     Int
  campaign_id Int?
  ab_test_id  Int?
  comment     String?   @db.Text
  rating      Int?
  statusi     String?   @default("aktiv") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)

  abtest abtest? @relation(fields: [ab_test_id], references: [id], map: "fk_feedback_abtest_rel")

  @@index([campaign_id], map: "fk_feedback_campaign")
  @@index([user_id], map: "fk_feedback_user")
  @@index([ab_test_id], map: "fk_feedback_abtest")
}


model abtest {
  id           Int       @id @default(autoincrement())
  campaign_id  Int
  variant_name String?
  metrics      String?   @db.LongText
  created_at   DateTime? @default(now()) @db.DateTime(0)
  updated_at   DateTime? @default(now()) @db.DateTime(0)

  campaign  campaigns  @relation(fields: [campaign_id], references: [id], map: "fk_abtest_campaign_rel")
  feedbacks feedback[]

  @@index([campaign_id], map: "fk_abtest_campaign")
}

